        // Vietnamese Pentatonic Scale (Hò - Xự - Xang - Xê - Cống) frequencies in Hz
        const SCALES = {
            pentatonic: [261.63, 293.66, 349.23, 392.00, 440.00, 523.25, 587.33, 698.46, 783.99],
            journey:    [293.66, 329.63, 392.00, 440.00, 493.88, 587.33, 659.25, 783.99],
