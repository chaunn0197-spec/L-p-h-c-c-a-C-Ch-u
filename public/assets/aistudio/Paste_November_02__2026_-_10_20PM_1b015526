        // Normalize all abbreviations & symbols for crisp, articulate Northern Vietnamese diction
        function normalizeVietnameseForTourGuide(rawText) {
            if (!rawText) return "";
            let t = rawText;

            const replacements = [
                [/\bTP\.\s*HCM\b/gi, "Thành phố Hồ Chí Minh"],
                [/\bTP\.HCM\b/gi, "Thành phố Hồ Chí Minh"],
                [/\bTP\.\s*/g, "Thành phố "],
                [/\bTW\b/g, "Trung ương"],
                [/\bVQG\b/g, "Vườn quốc gia"],
                [/\bĐBSCL\b/g, "Đồng bằng sông Cửu Long"],
                [/\bĐB\b/g, "Đồng bằng"],
                [/\bQL(\d+[A-Z]?)\b/g, "Quốc lộ $1"],
                [/\bUNESCO\b/g, "U-nét-xcô"],
                [/\bASEAN\b/g, "A-xê-an"],
                [/\bOCOP\b/g, "Ô-cốp"],
                [/\bMICE\b/g, "Mai-xờ"],
                [/\bGPS\s*0001\b/g, "Gờ Pê Ét không không không một"],
                [/\bATK\b/g, "An toàn khu"],
                [/\b4N3Đ\b/gi, "bốn ngày ba đêm"],
                [/\+/g, " kết hợp cùng "],
                [/➔|→/g, " kết nối đến "],
                [/&/g, " và "],
                [/\//g, " hoặc "],
                [/\(([^)]+)\)/g, ", $1, "]
            ];

            replacements.forEach(([regex, rep]) => {
                t = t.replace(regex, rep);
            });

            // Clean up multiple spaces and punctuation
            t = t.replace(/\s+/g, " ").replace(/\s+,/g, ",").replace(/,+/g, ",").trim();
            return t;
        }

        // Build an authentic, well-structured Northern Vietnamese Tour Guide narration script
        function buildProfessionalTourGuideScript(prov) {
            const cleanName = normalizeVietnameseForTourGuide(prov.name);
            const cleanRegion = normalizeVietnameseForTourGuide(prov.regionName);

            let mergerIntro = "";
            if (prov.mergedFrom.toLowerCase().includes("giữ nguyên")) {
                mergerIntro = `Đây là đơn vị hành chính giữ nguyên địa giới lịch sử, đóng vai trò trung tâm chiến lược của vùng ${cleanRegion}.`;
            } else {
                const mergedClean = normalizeVietnameseForTourGuide(prov.mergedFrom);
                mergerIntro = `Về không gian hành chính mới, địa phương được tổ chức trên cơ sở ${mergedClean.toLowerCase()}, thuộc vùng ${cleanRegion}.`;
            }

            const hubsNames = prov.hubs.map(h => normalizeVietnameseForTourGuide(h.name)).join(" và ");
            const hubSentence = prov.hubs.length > 1
                ? `Các tâm điểm đô thị và trạm trung chuyển du lịch chính trên bản đồ gồm có: ${hubsNames}.`
                : `Trung tâm hành chính và đầu mối giao thông trọng điểm đặt tại ${hubsNames}.`;

            const attractionSentences = prov.attractions.map((a, idx) => {
                const orderWord = idx === 0 ? "Trước hết, mời quý đoàn khám phá" : idx === 1 ? "Tiếp nối hành trình là" : "Điểm nhấn không thể bỏ qua tiếp theo là";
                const cName = normalizeVietnameseForTourGuide(a.name);
                const cDesc = normalizeVietnameseForTourGuide(a.desc);
                return `${orderWord} ${cName}. ${cDesc}`;
            });

            const topCuisine = normalizeVietnameseForTourGuide(prov.cuisine.slice(0, 4).join(", "));
            const routeTip = normalizeVietnameseForTourGuide(prov.routeAdvice);

            return [
                `Xin nồng nhiệt chào đón quý thầy cô và các bạn đã đặt chân đến ${cleanName}!`,
                `${mergerIntro} ${hubSentence}`,
                ...attractionSentences,
                `Về định hướng thiết kế tuyến: ${routeTip}`,
                `Dừng chân tại ${cleanName}, quý đoàn đừng quên thưởng thức các đặc sản nổi tiếng như: ${topCuisine}. Chúc quý đoàn có một chuyến khảo sát tuyến điểm thật nhiều trải nghiệm bổ ích!`
            ];
        }

        // Split paragraphs into bite-sized natural sentences (<= 175 chars) for smooth streaming & subtitle sync
        function splitIntoSpeakableChunks(paragraphs) {
            const chunks = [];
            paragraphs.forEach(para => {
                const sentences = para.split(/(?<=[.!?])\s+/);
                sentences.forEach(s => {
                    const trimmed = s.trim();
                    if (!trimmed) return;
                    if (trimmed.length <= 175) {
                        chunks.push(trimmed);
                    } else {
                        // Split by comma if sentence is very long
                        const parts = trimmed.split(/,\s+/);
                        let buf = "";
                        parts.forEach(part => {
                            if ((buf + ", " + part).length <= 170) {
                                buf = buf ? `${buf}, ${part}` : part;
                            } else {
                                if (buf) chunks.push(buf + ".");
                                buf = part;
                            }
                        });
                        if (buf) chunks.push(buf);
                    }
                });
            });
            return chunks;
        }

        function stopTourGuideVoice() {
            activeSpeechSessionId++;
            isTourGuideSpeaking = false;
            currentSpeechQueue = [];
            currentQueueIndex = 0;

            if ("speechSynthesis" in window) {
                window.speechSynthesis.cancel();
            }
            if (cloudAudioPlayer) {
                cloudAudioPlayer.pause();
                cloudAudioPlayer.src = "";
            }

            const subBox = document.getElementById("tour-guide-subtitle-box");
            if (subBox) subBox.classList.add("hidden");

            const stopBtn = document.getElementById("btn-voice-stop");
            if (stopBtn) stopBtn.classList.add("hidden");

            const label = document.getElementById("voice-guide-label");
            if (label) label.textContent = "Thuyết minh (Nữ HDV Miền Bắc)";

            const icon = document.getElementById("voice-guide-icon");
            if (icon) icon.className = "fa-solid fa-microphone-lines";
        }

        function speakProvinceGuide(forceRestart = false) {
            if (isTourGuideSpeaking && !forceRestart) {
                stopTourGuideVoice();
                return;
            }

            stopTourGuideVoice();
            const sessionId = ++activeSpeechSessionId;
            isTourGuideSpeaking = true;

            const paragraphs = buildProfessionalTourGuideScript(currentProvince);
            currentSpeechQueue = splitIntoSpeakableChunks(paragraphs);
            currentQueueIndex = 0;

            // Update UI Controls
            document.getElementById("tour-guide-subtitle-box").classList.remove("hidden");
            document.getElementById("btn-voice-stop").classList.remove("hidden");
            document.getElementById("voice-guide-label").textContent = "Đang thuyết minh...";
            document.getElementById("voice-guide-icon").className = "fa-solid fa-volume-high animate-pulse";

            cachedVietnameseFemaleVoice = detectNorthernVietnameseFemaleVoice();
            const useCloud = voiceEngineMode === "cloud_northern" ||
                             (voiceEngineMode === "auto_northern" && !cachedVietnameseFemaleVoice);

            const badge = document.getElementById("guide-voice-badge");
            if (useCloud) {
                badge.textContent = "Giọng Nữ Bắc (Cloud Chuẩn)";
            } else if (cachedVietnameseFemaleVoice) {
                badge.textContent = cachedVietnameseFemaleVoice.name.includes("HoaiMy")
                    ? "Nữ Miền Bắc (Hoài My Neural)"
                    : "Giọng Nữ Bắc Chuẩn";
            } else {
                badge.textContent = "Giọng Nữ Tiếng Việt";
            }

            playNextTourGuideChunk(sessionId, useCloud);
        }

        function playNextTourGuideChunk(sessionId, useCloud) {
            if (sessionId !== activeSpeechSessionId || !isTourGuideSpeaking) return;

            if (currentQueueIndex >= currentSpeechQueue.length) {
                stopTourGuideVoice();
                return;
            }

            const chunkText = currentSpeechQueue[currentQueueIndex];
            const subTextEl = document.getElementById("tour-guide-subtitle-text");
            if (subTextEl) {
                subTextEl.innerHTML = `<span class="text-pink-300 font-bold mr-1">[${currentQueueIndex + 1}/${currentSpeechQueue.length}]</span> ${chunkText}`;
            }

            if (useCloud) {
                playChunkViaCloudNorthernFemale(chunkText, sessionId);
            } else {
                playChunkViaWebSpeechFemale(chunkText, sessionId);
            }
        }

        // Engine 1: Cloud Standard Northern Female Voice Stream (Fallback to WebSpeech if offline)
        function playChunkViaCloudNorthernFemale(text, sessionId) {
            const encoded = encodeURIComponent(text);
            const url = `https://translate.googleapis.com/translate_tts?ie=UTF-8&q=${encoded}&tl=vi&client=tw-ob&ttsspeed=${voicePlaybackSpeed}`;

            cloudAudioPlayer.src = url;
            cloudAudioPlayer.playbackRate = voicePlaybackSpeed;

            cloudAudioPlayer.onended = () => {
                if (sessionId !== activeSpeechSessionId) return;
                currentQueueIndex++;
                setTimeout(() => playNextTourGuideChunk(sessionId, true), 140);
            };

            cloudAudioPlayer.onerror = () => {
                // Seamless fallback to Browser Web Speech API if CORS/network blocks audio stream
                if (sessionId !== activeSpeechSessionId) return;
                playChunkViaWebSpeechFemale(text, sessionId);
            };

            const playPromise = cloudAudioPlayer.play();
            if (playPromise !== undefined) {
                playPromise.catch(() => {
                    if (sessionId !== activeSpeechSessionId) return;
                    playChunkViaWebSpeechFemale(text, sessionId);
                });
            }
        }

        // Engine 2: Browser Neural Northern Female Voice (Microsoft HoaiMy / Google Tiếng Việt / Linh)
        function playChunkViaWebSpeechFemale(text, sessionId) {
            if (!("speechSynthesis" in window)) {
                stopTourGuideVoice();
                return;
            }

            window.speechSynthesis.cancel();
            const utter = new SpeechSynthesisUtterance(text);
            utter.lang = "vi-VN";

            const bestVoice = cachedVietnameseFemaleVoice || detectNorthernVietnameseFemaleVoice();
            if (bestVoice) {
                utter.voice = bestVoice;
            }

            // Calibrate pitch & rate for crisp, articulate Northern Female Tour Guide diction
            utter.rate = voicePlaybackSpeed;
            utter.pitch = bestVoice && bestVoice.name.includes("HoaiMy") ? 1.04 : 1.1;
            utter.volume = 1.0;

            utter.onend = () => {
                if (sessionId !== activeSpeechSessionId) return;
                currentQueueIndex++;
                setTimeout(() => playNextTourGuideChunk(sessionId, false), 120);
            };

            utter.onerror = () => {
                if (sessionId !== activeSpeechSessionId) return;
                currentQueueIndex++;
                setTimeout(() => playNextTourGuideChunk(sessionId, false), 120);
            };

            window.speechSynthesis.speak(utter);
        }

