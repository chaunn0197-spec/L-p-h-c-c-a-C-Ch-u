        function filterProvinceList() {
            const q = document.getElementById("search-province").value.trim().toLowerCase();
            const reg = document.getElementById("filter-region").value;
            const container = document.getElementById("province-list-container");
            container.innerHTML = "";

            const filtered = PROVINCES_34.filter(p => {
                const matchReg = reg === "ALL" || p.regionCode === reg;
                const matchText = !q ||
                    p.name.toLowerCase().includes(q) ||
                    p.mergedFrom.toLowerCase().includes(q) ||
                    p.hubs.some(h => h.name.toLowerCase().includes(q)) ||
                    p.attractions.some(a => a.name.toLowerCase().includes(q));
                return matchReg && matchText;
            });

            document.getElementById("filtered-count").textContent = `${filtered.length}/34 đơn vị`;

            filtered.forEach(p => {
                const isSelected = p.id === currentProvince.id;
                const isStamped = stampedProvinces.has(p.id);
                const item = document.createElement("div");
                item.className = `glass-card p-2.5 rounded-xl cursor-pointer flex items-center justify-between gap-2 ${isSelected ? 'ring-2 ring-cyan-400 bg-cyan-950/60' : ''}`;
