        /***********************************************************************
         * 6. CAMERA NAVIGATION & RAYCASTING INTERACTION
         ***********************************************************************/
        function flyCameraTo(targetCamPos, targetLookAt) {
            camAnim.active = true;
            camAnim.startPos.copy(camera.position);
            camAnim.endPos.copy(targetCamPos);
            camAnim.startTarget.copy(controls.target);
            camAnim.endTarget.copy(targetLookAt);
            camAnim.progress = 0;
        }

        function flyCameraToProvince(prov) {
            const targetLook = new THREE.Vector3(prov.x, 1.2, prov.z);
            const targetPos = new THREE.Vector3(prov.x + 8.5, 14.5, prov.z + 11.5);
            flyCameraTo(targetPos, targetLook);
        }

        function resetCameraOverview() {
            chaseCameraActive = false;
            updateChaseCamButton();
            flyCameraTo(new THREE.Vector3(12, 58, 35), new THREE.Vector3(3, 0, -5));
        }

        let pointerDownPos = { x: 0, y: 0 };
        let hoveredMesh = null;

        function onPointerDown(e) {
            pointerDownPos.x = e.clientX;
            pointerDownPos.y = e.clientY;
        }

        function onPointerMove(e) {
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(provinceMeshes, false);
            const tooltip = document.getElementById("hover-tooltip");

            if (intersects.length > 0) {
                const hit = intersects[0].object;
                document.body.style.cursor = "pointer";

                let prov = null;
                if (hit.userData.type === "province") {
                    prov = hit.userData.province;
                } else if (hit.userData.type === "island") {
                    const isl = hit.userData.island;
                    prov = PROVINCES_34.find(p => p.id === isl.parentProvinceId);
                }

                if (prov) {
                    if (hoveredMesh && hoveredMesh !== provinceMeshMap[prov.id]) {
                        hoveredMesh.userData.targetY = hoveredMesh.userData.province.id === currentProvince.id ? 0.55 : 0;
                    }
                    hoveredMesh = provinceMeshMap[prov.id];
                    if (hoveredMesh) hoveredMesh.userData.targetY = 0.65;

                    // Update Tooltip
                    tooltip.classList.remove("hidden");
                    tooltip.style.left = `${Math.min(window.innerWidth - 260, e.clientX + 16)}px`;
                    tooltip.style.top = `${Math.max(16, e.clientY - 20)}px`;
                    document.getElementById("tooltip-color").style.backgroundColor = prov.color;
                    document.getElementById("tooltip-name").textContent = `${prov.stt}. ${prov.name}`;
                    document.getElementById("tooltip-merged").textContent = prov.mergedFrom;
                    document.getElementById("tooltip-hubs").textContent = `Tâm điểm: ${prov.hubs.map(h => h.name).join(" • ")}`;

                    const stampBadge = document.getElementById("tooltip-stamped");
                    if (stampedProvinces.has(prov.id)) stampBadge.classList.remove("hidden");
                    else stampBadge.classList.add("hidden");
                }
            } else {
                document.body.style.cursor = "grab";
                tooltip.classList.add("hidden");
                if (hoveredMesh) {
                    hoveredMesh.userData.targetY = hoveredMesh.userData.province.id === currentProvince.id ? 0.55 : 0;
                    hoveredMesh = null;
                }
            }
        }

        function onPointerUp(e) {
            const moveDist = Math.hypot(e.clientX - pointerDownPos.x, e.clientY - pointerDownPos.y);
            if (moveDist > 6) return; // Dragging camera, not clicking

            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(provinceMeshes, false);

            if (intersects.length > 0) {
                const hit = intersects[0].object;
                let prov = null;
                if (hit.userData.type === "province") {
                    prov = hit.userData.province;
                } else if (hit.userData.type === "island") {
                    prov = PROVINCES_34.find(p => p.id === hit.userData.island.parentProvinceId);
                }

                if (prov) {
                    playSfx("click");
                    if (gameMode === "challenge") {
                        addProvinceToChallenge(prov);
                    }
                    selectProvince(prov, true);
                }
            }
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

