                const p = PROVINCES_34.find(x => x.id === id);
                return `<span class="px-2.5 py-1 rounded-lg bg-cyan-500/20 border border-cyan-400 text-cyan-200 font-bold">${i + 1}. ${p.name}</span>`;
            }).join(' <i class="fa-solid fa-arrow-right text-amber-400"></i> ');
        }

        function verifyTourChallenge() {
            const ch = TOUR_CHALLENGES[currentChallengeIdx];
            const fb = document.getElementById("challenge-feedback");
            fb.classList.remove("hidden");

            const isMatch = ch.targetIds.length === challengeSelectedIds.length &&
                            ch.targetIds.every(id => challengeSelectedIds.includes(id));

            if (isMatch) {
                playSfx("stamp");
                ch.targetIds.forEach(id => stampedProvinces.add(id));
                updatePassportCounter();
                fb.className = "mt-2 text-xs font-bold text-emerald-300";
                fb.innerHTML = `🎉 Tuyệt vời! Tuyến liên kết [${ch.targetNames.join(" ➔ ")}] hoàn toàn hợp lý về địa lý và tài nguyên du lịch! Đã tặng dấu Hộ chiếu cho cả 3 tỉnh.`;
            } else {
                fb.className = "mt-2 text-xs font-bold text-amber-300";
                fb.innerHTML = `💡 Gợi ý đáp án chuẩn: ${ch.targetNames.join(" ➔ ")}. Hãy bấm 'Xóa' và chọn lại trên bản đồ!`;
            }
        }

        /***********************************************************************
         * 10. MAIN RENDER & ANIMATION LOOP
         ***********************************************************************/
        let clock = new THREE.Clock();

        function animateLoop() {
            requestAnimationFrame(animateLoop);
            const delta = clock.getDelta();
            const elapsed = clock.getElapsedTime();

            // 1. Subtle Ocean Wave Animation
            if (oceanMesh) {
                oceanMesh.position.y = -0.35 + Math.sin(elapsed * 1.5) * 0.04;
            }

            // 2. Smooth Province Elevation on Hover/Select
            provinceMeshes.forEach(m => {
                if (m.userData.type === "province") {
                    m.position.y += (m.userData.targetY - m.position.y) * 0.14;
                }
            });

            // 3. Camera Fly-to Interpolation
            if (camAnim.active && !chaseCameraActive) {
                camAnim.progress += delta / camAnim.duration;
                if (camAnim.progress >= 1) {
                    camAnim.progress = 1;
                    camAnim.active = false;
                }
                // Ease out cubic
                const t = 1 - Math.pow(1 - camAnim.progress, 3);
                camera.position.lerpVectors(camAnim.startPos, camAnim.endPos, t);
                controls.target.lerpVectors(camAnim.startTarget, camAnim.endTarget, t);
            }

            // 4. Active 3D Vehicle Travel Along Route Curve
            if (activeTravel.active && activeTravel.curve && activeTravel.vehicleMesh) {
                activeTravel.progress += activeTravel.speed;
                const progressBar = document.getElementById("telemetry-progress");
                if (progressBar) {
                    progressBar.style.width = `${Math.min(100, Math.round(activeTravel.progress * 100))}%`;
                }

                if (activeTravel.progress >= 1) {
                    // Arrived at Destination Province
                    activeTravel.progress = 1;
                    activeTravel.active = false;
                    originProvince = activeTravel.destination;
                    document.getElementById("current-location-badge").textContent = `📍 Đang ở: ${originProvince.name}`;
                    document.getElementById("select-origin").value = originProvince.id;
                    document.getElementById("telemetry-status").textContent = `✅ Đã đến ${originProvince.name}! Nữ HDV bắt đầu thuyết minh tuyến điểm...`;
                    playSfx("click");

                    // Automatically trigger Female Northern Tour Guide Narration upon arrival
                    if (autoNarrateOnArrival && gameMode === "explore") {
                        selectProvince(originProvince, false);
                        setTimeout(() => speakProvinceGuide(true), 350);
                    }
                } else {
                    const pos = activeTravel.curve.getPointAt(activeTravel.progress);
                    const lookAtPt = activeTravel.curve.getPointAt(Math.min(1, activeTravel.progress + 0.02));
                    activeTravel.vehicleMesh.position.copy(pos);
                    activeTravel.vehicleMesh.lookAt(lookAtPt);

                    if (chaseCameraActive) {
                        const camOffset = new THREE.Vector3(4.5, 5.5, 6.5);
                        camera.position.lerp(pos.clone().add(camOffset), 0.1);
                        controls.target.lerp(pos, 0.15);
                    }
                }
            }

            controls.update();
            renderer.render(scene, camera);

            // 5. Update 2D HTML Floating Labels Positions
            if (showMapLabels) {
                const halfW = window.innerWidth / 2;
                const halfH = window.innerHeight / 2;
                labelElements.forEach(item => {
                    const v = item.pos.clone();
                    v.project(camera);
                    if (v.z > 1) {
                        item.el.style.display = "none";
                    } else {
                        const x = (v.x * halfW) + halfW;
                        const y = -(v.y * halfH) + halfH;
                        item.el.style.display = "flex";
                        item.el.style.left = `${x}px`;
                        item.el.style.top = `${y}px`;
                    }
                });
            }
        }

        // Initialize Everything on Window Load
        window.onload = function () {
            initThreeScene();
            populateSelectDropdowns();
            filterProvinceList();
            selectProvince(PROVINCES_34[8], false); // Quảng Ninh highlighted initially
            updatePassportCounter();
            animateLoop();
        };
    </script>
</body>
