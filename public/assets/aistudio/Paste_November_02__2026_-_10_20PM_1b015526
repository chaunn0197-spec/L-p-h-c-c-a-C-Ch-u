        /***********************************************************************
         * 8. NORTHERN VIETNAMESE FEMALE TOUR GUIDE NARRATION SYSTEM
         * - Dual-Engine: Neural Northern Female (HoaiMy / Google / Linh) + Cloud Stream Fallback
         * - Phonetic Normalization: Eliminates abbreviations, lisp/slurring, and stutters
         * - Professional Tour Guide Script + Live Subtitles
         ***********************************************************************/
        let voiceEngineMode = "auto_northern"; // 'auto_northern' | 'cloud_northern' | 'browser_female'
        let voicePlaybackSpeed = 0.98;
        let autoNarrateOnArrival = true;
        let cachedVietnameseFemaleVoice = null;
