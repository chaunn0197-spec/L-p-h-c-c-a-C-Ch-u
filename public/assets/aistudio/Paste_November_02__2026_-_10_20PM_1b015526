        function startMusicScheduler() {
            if (musicInterval) clearInterval(musicInterval);
            const scale = SCALES[musicStyle] || SCALES.pentatonic;
            const tempoMs = musicStyle === "journey" ? 360 : musicStyle === "zen" ? 720 : 480;

            musicInterval = setInterval(() => {
                if (!isMusicPlaying) return;
                // Auto-duck background music volume when the Female Tour Guide is narrating
                const baseVol = isTourGuideSpeaking ? 0.018 : 0.065;
                const bassVol = isTourGuideSpeaking ? 0.010 : 0.04;

                const patternIdx = MELODY_PATTERNS[melodyStep % MELODY_PATTERNS.length];
                const noteFreq = scale[patternIdx % scale.length];
                const wave = musicStyle === "zen" ? "sine" : "triangle";
                playPluckNote(noteFreq, musicStyle === "zen" ? 2.4 : 1.5, baseVol, wave);

                // Occasional harmony bass note on beat 0 and 8
                if (melodyStep % 4 === 0) {
                    playPluckNote(scale[0] * 0.5, 2.5, bassVol, "sine");
                }
                melodyStep++;
            }, tempoMs);
        }

