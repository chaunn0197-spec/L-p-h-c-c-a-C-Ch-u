        // Scan and select the best Northern Vietnamese Female Voice (Hoài My / Google Tiếng Việt / Linh)
        function detectNorthernVietnameseFemaleVoice() {
            if (!("speechSynthesis" in window)) return null;
            const voices = window.speechSynthesis.getVoices();
            if (!voices || voices.length === 0) return null;

            const viVoices = voices.filter(v =>
                v.lang.toLowerCase().includes("vi") ||
                v.name.toLowerCase().includes("vietnam") ||
                v.name.toLowerCase().includes("tiếng việt")
            );

            if (viVoices.length === 0) return null;

            // Filter OUT explicitly male voices (e.g., Microsoft NamMinh, Male, Nam)
            const femaleCandidates = viVoices.filter(v => {
                const n = v.name.toLowerCase();
                return !n.includes("namminh") && !n.includes("male") && !n.includes(" nam ");
            });

            const pool = femaleCandidates.length > 0 ? femaleCandidates : viVoices;

            // Priority 1: Microsoft HoaiMy Online (Natural) - Standard Northern Vietnamese Female Voice
            const hoaiMy = pool.find(v => v.name.toLowerCase().includes("hoaimy") || v.name.toLowerCase().includes("hoài my"));
            if (hoaiMy) return hoaiMy;

            // Priority 2: Google Tiếng Việt (Standard Clear Northern Female TTS)
            const googleVi = pool.find(v => v.name.toLowerCase().includes("google"));
            if (googleVi) return googleVi;

            // Priority 3: Apple Linh (vi-VN Female) or any Natural/Online Female Vietnamese voice
            const linhOrNatural = pool.find(v =>
                v.name.toLowerCase().includes("linh") ||
                v.name.toLowerCase().includes("natural") ||
                v.name.toLowerCase().includes("female") ||
                v.name.toLowerCase().includes("nữ")
            );
            if (linhOrNatural) return linhOrNatural;

            return pool[0];
        }

        if ("speechSynthesis" in window) {
            window.speechSynthesis.onvoiceschanged = () => {
                cachedVietnameseFemaleVoice = detectNorthernVietnameseFemaleVoice();
                updateVoiceSelectorLabel();
            };
            setTimeout(() => {
                cachedVietnameseFemaleVoice = detectNorthernVietnameseFemaleVoice();
                updateVoiceSelectorLabel();
