        };

        const MELODY_PATTERNS = [0, 2, 3, 4, 5, 4, 2, 1, 3, 5, 6, 5, 3, 2, 0, 4];

        function initAudioEngine() {
            if (!audioCtx) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContextClass();
            }
            if (audioCtx.state === "suspended") {
                audioCtx.resume();
            }
        }

        function playPluckNote(freq, duration = 1.6, volume = 0.08, waveType = "triangle") {
            if (!audioCtx || !isMusicPlaying) return;
            const now = audioCtx.currentTime;

            // Main string oscillator (Đàn tranh / Đàn bầu warm timbre)
            const osc = audioCtx.createOscillator();
            const subOsc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            const filter = audioCtx.createBiquadFilter();

            osc.type = waveType;
            osc.frequency.setValueAtTime(freq, now);
            // Subtle pitch bend characteristic of Vietnamese traditional instruments
            osc.frequency.exponentialRampToValueAtTime(freq * 1.006, now + 0.18);
            osc.frequency.exponentialRampToValueAtTime(freq, now + 0.45);

            subOsc.type = "sine";
            subOsc.frequency.setValueAtTime(freq * 0.5, now);

            filter.type = "lowpass";
            filter.frequency.setValueAtTime(1800, now);
            filter.frequency.exponentialRampToValueAtTime(420, now + duration);

            gain.gain.setValueAtTime(0.001, now);
            gain.gain.linearRampToValueAtTime(volume, now + 0.03);
            gain.gain.exponentialRampToValueAtTime(0.0008, now + duration);

            osc.connect(filter);
            subOsc.connect(filter);
            filter.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start(now);
            subOsc.start(now);
            osc.stop(now + duration);
            subOsc.stop(now + duration);
        }

        function playSfx(type) {
            try {
                initAudioEngine();
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === "click") {
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(520, now);
                    osc.frequency.exponentialRampToValueAtTime(780, now + 0.09);
                    gain.gain.setValueAtTime(0.06, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
                    osc.start(now);
                    osc.stop(now + 0.09);
                } else if (type === "depart") {
                    osc.type = "triangle";
                    osc.frequency.setValueAtTime(330, now);
                    osc.frequency.exponentialRampToValueAtTime(660, now + 0.35);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } else if (type === "stamp") {
                    // Celebratory chord
                    [523.25, 659.25, 783.99, 1046.5].forEach((f, idx) => {
                        const o = audioCtx.createOscillator();
                        const g = audioCtx.createGain();
                        o.type = "triangle";
                        o.frequency.setValueAtTime(f, now + idx * 0.07);
                        g.gain.setValueAtTime(0.08, now + idx * 0.07);
                        g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.07 + 0.5);
                        o.connect(g);
                        g.connect(audioCtx.destination);
                        o.start(now + idx * 0.07);
                        o.stop(now + idx * 0.07 + 0.5);
                    });
                }
            } catch (e) {
                // Ignore audio context restrictions before user gesture
            }
        }

        function toggleBackgroundMusic() {
            initAudioEngine();
            isMusicPlaying = !isMusicPlaying;
            const icon = document.getElementById("music-icon");
