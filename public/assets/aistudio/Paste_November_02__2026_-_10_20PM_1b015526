            const stoneMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, roughness: 0.7 });
            const redMat = new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.4 });
            const greenMat = new THREE.MeshStandardMaterial({ color: 0x10b981, roughness: 0.6 });
            const cyanMat = new THREE.MeshStandardMaterial({ color: 0x38bdf8, roughness: 0.3, metalness: 0.5 });

            if (type === "halong") {
                // Limestone Karsts & Cruise Boat
                const k1 = new THREE.Mesh(new THREE.ConeGeometry(0.42, 1.45, 6), greenMat);
                k1.position.set(-0.3, 0.7, 0);
                const k2 = new THREE.Mesh(new THREE.ConeGeometry(0.32, 1.1, 6), greenMat);
                k2.position.set(0.35, 0.55, 0.2);
                const boat = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.2, 0.22), goldMat);
                boat.position.set(0, 0.15, 0.45);
                g.add(k1, k2, boat);
            } else if (type === "khue_van_cac" || type === "imperial_gate") {
                // Traditional Pavilion / Gate
                const base = new THREE.Mesh(new THREE.BoxGeometry(0.75, 0.35, 0.75), stoneMat);
                base.position.y = 0.17;
                const body = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.45, 0.55), redMat);
                body.position.y = 0.55;
                const roof = new THREE.Mesh(new THREE.ConeGeometry(0.62, 0.4, 4), goldMat);
                roof.position.y = 0.95;
                roof.rotation.y = Math.PI / 4;
                g.add(base, body, roof);
            } else if (type === "flagpole") {
                // Lũng Cú Flagpole
                const base = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.45, 0.45, 8), stoneMat);
                base.position.y = 0.22;
                const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.07, 1.4, 8), goldMat);
                pole.position.y = 0.9;
                const flag = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.32, 0.04), redMat);
                flag.position.set(0.25, 1.45, 0);
                g.add(base, pole, flag);
            } else if (type === "golden_bridge") {
                // Curved Golden Bridge
                const arch = new THREE.Mesh(new THREE.TorusGeometry(0.55, 0.09, 8, 20, Math.PI), goldMat);
                arch.position.y = 0.1;
                const p1 = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.15, 0.6, 8), stoneMat);
                p1.position.set(-0.3, 0.3, 0);
                const p2 = p1.clone();
                p2.position.set(0.3, 0.3, 0);
                g.add(arch, p1, p2);
            } else if (type === "skyscraper") {
                // Landmark 81 spire
