        function create3DVehicleMesh(mode) {
            const g = new THREE.Group();
            if (mode === "air") {
                // 3D Airplane
                const body = new THREE.Mesh(
                    new THREE.ConeGeometry(0.28, 1.6, 12),
                    new THREE.MeshStandardMaterial({ color: 0xf8fafc, metalness: 0.4, roughness: 0.2 })
                );
                body.rotation.x = Math.PI / 2;
                const wings = new THREE.Mesh(
                    new THREE.BoxGeometry(1.7, 0.06, 0.38),
                    new THREE.MeshStandardMaterial({ color: 0x38bdf8 })
                );
                const tail = new THREE.Mesh(
                    new THREE.BoxGeometry(0.08, 0.45, 0.35),
                    new THREE.MeshStandardMaterial({ color: 0xf59e0b })
                );
                tail.position.set(0, 0.22, -0.6);
                g.add(body, wings, tail);
            } else if (mode === "water") {
                // 3D Cruise Ship / Express Train
                const hull = new THREE.Mesh(
                    new THREE.BoxGeometry(0.55, 0.35, 1.35),
                    new THREE.MeshStandardMaterial({ color: 0x10b981 })
                );
                const deck = new THREE.Mesh(
                    new THREE.BoxGeometry(0.42, 0.28, 0.85),
                    new THREE.MeshStandardMaterial({ color: 0xffffff })
                );
                deck.position.y = 0.3;
                g.add(hull, deck);
            } else {
                // 3D Luxury Tour Coach (Xe du lịch)
                const coach = new THREE.Mesh(
                    new THREE.BoxGeometry(0.52, 0.45, 1.2),
                    new THREE.MeshStandardMaterial({ color: 0xf59e0b })
                );
                coach.position.y = 0.25;
                const cabin = new THREE.Mesh(
                    new THREE.BoxGeometry(0.54, 0.22, 0.85),
                    new THREE.MeshStandardMaterial({ color: 0x0284c7 })
                );
                cabin.position.y = 0.32;
                g.add(coach, cabin);
            }
            return g;
        }

        function launch3DJourney(fromProv, toProv, mode) {
            if (!fromProv || !toProv) return;
            playSfx("depart");

            // Clear previous route & vehicle
            while (routeGroup.children.length > 0) routeGroup.remove(routeGroup.children[0]);
            while (vehicleGroup.children.length > 0) vehicleGroup.remove(vehicleGroup.children[0]);

            const startPt = new THREE.Vector3(fromProv.x, 1.55, fromProv.z);
            const endPt = new THREE.Vector3(toProv.x, 1.55, toProv.z);
            const dist3D = startPt.distanceTo(endPt);

            // Real-world approximate distance in km
            const approxKm = Math.max(45, Math.round(dist3D * 22));

            // Arc height depends on transport mode
            const arcHeight = mode === "air" ? Math.min(14, Math.max(4.5, dist3D * 0.32)) : 2.1;
            const midPt = new THREE.Vector3().addVectors(startPt, endPt).multiplyScalar(0.5);
            midPt.y += arcHeight;

            const curve = new THREE.QuadraticBezierCurve3(startPt, midPt, endPt);

            // Glowing Trajectory Tube
            const tubeGeo = new THREE.TubeGeometry(curve, 64, 0.11, 8, false);
            const tubeColor = mode === "air" ? 0x38bdf8 : mode === "water" ? 0x34d399 : 0xfbbf24;
            const tubeMat = new THREE.MeshBasicMaterial({ color: tubeColor, transparent: true, opacity: 0.85 });
            const tubeMesh = new THREE.Mesh(tubeGeo, tubeMat);
            routeGroup.add(tubeMesh);

            // Create Vehicle Mesh
            const vMesh = create3DVehicleMesh(mode);
            vehicleGroup.add(vMesh);

            activeTravel = {
                active: true,
                curve: curve,
                progress: 0,
                speed: mode === "air" ? 0.0065 : 0.0045,
                mode: mode,
                origin: fromProv,
                destination: toProv,
                distanceKm: approxKm,
                vehicleMesh: vMesh
            };

            // Show Telemetry UI
            const telemetryBox = document.getElementById("journey-telemetry");
            telemetryBox.classList.remove("hidden");
            document.getElementById("telemetry-route").textContent = `${fromProv.name} ➔ ${toProv.name}`;
            document.getElementById("telemetry-dist").textContent = `~${approxKm} km`;
            const modeLabel = mode === "air" ? "Đường bay nội địa" : mode === "water" ? "Tuyến Đường thủy / Đường sắt" : "Tuyến Cao tốc / Quốc lộ";
            document.getElementById("telemetry-status").textContent = `${modeLabel}: Khởi hành từ ${fromProv.hubs[0].name} đến ${toProv.hubs[0].name}...`;

            // If Chase Cam is not active, smoothly frame both provinces
            if (!chaseCameraActive) {
                flyCameraTo(
                    new THREE.Vector3(midPt.x + 14, Math.max(18, dist3D * 0.85), midPt.z + 16),
                    new THREE.Vector3(midPt.x, 1, midPt.z)
                );
            }
        }

