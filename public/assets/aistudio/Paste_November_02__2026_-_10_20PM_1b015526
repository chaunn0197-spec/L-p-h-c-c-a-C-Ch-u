        function selectProvince(prov, flyCam = true) {
            currentProvince = prov;

            // Highlight 3D Mesh elevation
            PROVINCES_34.forEach(p => {
                const m = provinceMeshMap[p.id];
                if (!m) return;
                if (p.id === prov.id) {
                    m.userData.targetY = 0.55;
                    m.material.emissive.setHex(0x1e40af);
                } else {
                    m.userData.targetY = 0;
                    m.material.emissive.copy(m.userData.baseColor).multiplyScalar(0.08);
                }
            });

            document.getElementById("select-destination").value = prov.id;
            filterProvinceList();
            renderDossierPanel();

            if (flyCam) {
                flyCameraToProvince(prov);
            }
