<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VIETNAM TOURISM ROUTE MASTER 3D - Sa bàn 34 Tỉnh Thành</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js & OrbitControls -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            font-family: 'Be Vietnam Pro', sans-serif;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #061326;
            color: #f8fafc;
        }
        #canvas-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        /* Glassmorphism Panels */
        .glass-panel {
            background: rgba(10, 25, 47, 0.82);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(56, 189, 248, 0.25);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
        }
        .glass-card {
            background: rgba(15, 35, 65, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.2s ease;
        }
        .glass-card:hover {
            border-color: rgba(56, 189, 248, 0.5);
            background: rgba(20, 45, 82, 0.85);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(10, 25, 47, 0.5);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.4);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(56, 189, 248, 0.8);
        }
        /* 3D Floating Label */
        .province-label {
            position: absolute;
            pointer-events: none;
            transform: translate(-50%, -100%);
            z-index: 5;
            white-space: nowrap;
            text-shadow: 0 2px 4px rgba(0,0,0,0.95);
            transition: opacity 0.2s, transform 0.2s;
        }
        .island-label {
            position: absolute;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 4;
            white-space: nowrap;
            text-shadow: 0 2px 5px rgba(0,0,0,0.95);
        }
        /* Pulse Animation for Active Hub */
        @keyframes pulseRing {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(56, 189, 248, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
        }
        .pulse-badge {
            animation: pulseRing 2s infinite;
        }
        /* Equalizer Animation for Music Button */
        @keyframes eqBar {
            0%, 100% { height: 4px; }
            50% { height: 14px; }
        }
        .eq-bar {
            width: 3px;
            background-color: #38bdf8;
            border-radius: 2px;
            display: inline-block;
            margin: 0 1px;
        }
        .playing .eq-bar:nth-child(1) { animation: eqBar 0.7s infinite ease-in-out; }
        .playing .eq-bar:nth-child(2) { animation: eqBar 0.5s infinite ease-in-out 0.2s; }
        .playing .eq-bar:nth-child(3) { animation: eqBar 0.8s infinite ease-in-out 0.4s; }
        /* Tour Guide Voice Wave Animation */
        @keyframes voiceWave {
            0%, 100% { transform: scaleY(0.35); }
            50% { transform: scaleY(1.15); }
        }
        .voice-bar {
            width: 3px;
            height: 16px;
            background: linear-gradient(to top, #38bdf8, #f472b6);
            border-radius: 999px;
            display: inline-block;
            margin: 0 1.5px;
            transform-origin: bottom;
        }
        .speaking .voice-bar:nth-child(1) { animation: voiceWave 0.55s infinite ease-in-out; }
        .speaking .voice-bar:nth-child(2) { animation: voiceWave 0.4s infinite ease-in-out 0.15s; }
        .speaking .voice-bar:nth-child(3) { animation: voiceWave 0.65s infinite ease-in-out 0.25s; }
        .speaking .voice-bar:nth-child(4) { animation: voiceWave 0.45s infinite ease-in-out 0.1s; }
    </style>
</head>
<body class="relative select-none">

    <!-- 3D WebGL Canvas Container -->
    <div id="canvas-container"></div>

    <!-- Floating HTML Labels Container -->
    <div id="labels-container" class="absolute inset-0 pointer-events-none overflow-hidden z-10"></div>

    <!-- Hover Tooltip -->
    <div id="hover-tooltip" class="fixed pointer-events-none z-50 hidden glass-panel px-3.5 py-2.5 rounded-xl border border-cyan-400/50 shadow-2xl transition-opacity duration-150">
        <div class="flex items-center gap-2">
            <span id="tooltip-color" class="w-3 h-3 rounded-full inline-block border border-white"></span>
            <span id="tooltip-name" class="font-bold text-sm text-white tracking-wide"></span>
            <span id="tooltip-stamped" class="text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 px-1.5 py-0.5 rounded hidden"><i class="fa-solid fa-stamp mr-1"></i>Đã đóng dấu</span>
        </div>
        <div id="tooltip-merged" class="text-[11px] text-cyan-200/90 mt-0.5"></div>
        <div id="tooltip-hubs" class="text-[11px] text-amber-300/90 mt-0.5 font-medium"></div>
    </div>

    <!-- TOP NAVIGATION & CONTROL BAR -->
    <header class="fixed top-3 left-3 right-3 z-30 flex flex-wrap items-center justify-between gap-2 glass-panel px-4 py-2.5 rounded-2xl">
        <!-- Brand & Title -->
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 via-red-500 to-rose-600 flex items-center justify-center shadow-lg shadow-red-500/20 border border-amber-300/40">
                <i class="fa-solid fa-earth-asia text-white text-xl"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-sm md:text-base font-extrabold tracking-wider bg-gradient-to-r from-amber-300 via-cyan-200 to-emerald-300 bg-clip-text text-transparent">
                        VIETNAM TOURISM ROUTE MASTER 3D
                    </h1>
                    <span class="hidden sm:inline-block text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">
                        Bản đồ 34 Tỉnh Thành
                    </span>
                </div>
                <p class="text-[11px] text-slate-300 hidden md:block">
                    Sa bàn Tương tác Tuyến điểm Du lịch Việt Nam • Di chuyển Đa phương thức & Hộ chiếu Di sản
                </p>
            </div>
        </div>

        <!-- Mode Switcher -->
        <div class="flex items-center bg-slate-900/80 p-1 rounded-xl border border-slate-700/70">
            <button onclick="switchGameMode('explore')" id="mode-btn-explore" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 bg-cyan-600 text-white shadow">
                <i class="fa-solid fa-compass"></i>
                <span>Khám phá & Lữ hành</span>
            </button>
            <button onclick="switchGameMode('challenge')" id="mode-btn-challenge" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 text-slate-300 hover:text-white">
                <i class="fa-solid fa-route"></i>
                <span>Thử thách Thiết kế Tuyến</span>
            </button>
            <button onclick="togglePassportModal()" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 text-amber-300 hover:bg-amber-500/10">
                <i class="fa-solid fa-passport"></i>
                <span>Hộ chiếu (<span id="passport-count-top">0</span>/34)</span>
            </button>
        </div>

        <!-- Audio & Camera Controls -->
        <div class="flex items-center gap-2">
            <!-- Music Synthesizer Control -->
            <div class="flex items-center bg-slate-900/85 rounded-xl px-2.5 py-1 border border-slate-700/80 gap-2">
                <button id="music-toggle-btn" onclick="toggleBackgroundMusic()" class="flex items-center gap-1.5 text-xs font-semibold text-cyan-300 hover:text-white py-1 px-1.5 rounded-lg transition" title="Bật/Tắt Nhạc nền Ngũ Cung">
                    <i id="music-icon" class="fa-solid fa-volume-xmark text-slate-400"></i>
                    <span id="music-status-text" class="hidden xl:inline">Nhạc nền: Tắt</span>
                    <div id="music-eq" class="flex items-end h-3.5 ml-0.5">
                        <span class="eq-bar"></span>
                        <span class="eq-bar"></span>
                        <span class="eq-bar"></span>
                    </div>
                </button>
                <select id="music-style-select" onchange="changeMusicStyle(this.value)" class="bg-slate-800 text-[11px] text-slate-200 rounded-lg px-2 py-1 border border-slate-600 focus:outline-none focus:border-cyan-400">
                    <option value="pentatonic">🎵 Ngũ cung Du lịch (Đàn tranh)</option>
                    <option value="journey">🚀 Giai điệu Hành trình Xuyên Việt</option>
                    <option value="zen">🍃 Thanh âm Sinh thái (Ambient)</option>
                </select>
            </div>

            <!-- Toggle Labels -->
            <button onclick="toggleMapLabels()" id="btn-toggle-labels" class="p-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-cyan-300 border border-slate-600 text-xs flex items-center gap-1" title="Ẩn/Hiện tên 34 tỉnh trên bản đồ">
                <i class="fa-solid fa-tags"></i>
                <span class="hidden lg:inline">Nhãn tên</span>
            </button>

            <!-- Reset Camera -->
            <button onclick="resetCameraOverview()" class="p-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-400/40 text-xs font-semibold flex items-center gap-1" title="Về góc nhìn Toàn cảnh Việt Nam">
                <i class="fa-solid fa-expand"></i>
                <span class="hidden lg:inline">Toàn cảnh</span>
            </button>
        </div>
    </header>

    <!-- LEFT SIDEBAR: DIRECTORY OF 34 PROVINCES & ROUTE PLANNER -->
    <aside id="left-sidebar" class="fixed top-20 left-3 bottom-3 w-80 md:w-88 z-20 flex flex-col gap-2.5 transition-transform duration-300">
        
        <!-- 1. INTER-PROVINCIAL TRAVEL & TRANSPORT CONTROLLER -->
        <div class="glass-panel rounded-2xl p-3.5 flex flex-col gap-2.5">
            <div class="flex items-center justify-between border-b border-slate-700/70 pb-2">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-plane-departure text-cyan-400 text-sm"></i>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-300">Điều hành Di chuyển Liên tỉnh</h2>
                </div>
                <span id="current-location-badge" class="text-[11px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full border border-emerald-500/30 font-medium">
                    📍 Đang ở: Hà Nội
                </span>
            </div>

            <!-- Origin & Destination Selectors -->
            <div class="grid grid-cols-2 gap-2 text-xs">
                <div>
                    <label class="text-[10px] text-slate-400 block mb-1">Điểm xuất phát (Tỉnh A)</label>
                    <select id="select-origin" class="w-full bg-slate-900/90 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white focus:outline-none focus:border-cyan-400"></select>
                </div>
                <div>
                    <label class="text-[10px] text-slate-400 block mb-1">Điểm đến tham quan (Tỉnh B)</label>
                    <select id="select-destination" class="w-full bg-slate-900/90 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-amber-300 font-semibold focus:outline-none focus:border-amber-400"></select>
                </div>
            </div>

            <!-- Transport Mode Selection -->
            <div class="grid grid-cols-3 gap-1.5 pt-0.5">
                <button onclick="setTransportMode('road')" id="trans-road" class="transport-btn py-1.5 px-2 rounded-lg text-[11px] font-semibold border border-cyan-400 bg-cyan-500/20 text-white flex flex-col items-center gap-0.5 transition">
                    <i class="fa-solid fa-bus text-amber-300"></i>
                    <span>Đường bộ</span>
                </button>
                <button onclick="setTransportMode('air')" id="trans-air" class="transport-btn py-1.5 px-2 rounded-lg text-[11px] font-semibold border border-slate-700 bg-slate-800/60 text-slate-300 flex flex-col items-center gap-0.5 transition hover:border-slate-500">
                    <i class="fa-solid fa-plane text-sky-300"></i>
                    <span>Hàng không</span>
                </button>
                <button onclick="setTransportMode('water')" id="trans-water" class="transport-btn py-1.5 px-2 rounded-lg text-[11px] font-semibold border border-slate-700 bg-slate-800/60 text-slate-300 flex flex-col items-center gap-0.5 transition hover:border-slate-500">
                    <i class="fa-solid fa-ship text-emerald-300"></i>
                    <span>Thủy / Sắt</span>
                </button>
            </div>

            <!-- Action & Chase Cam Toggle -->
            <div class="flex items-center gap-2 pt-1">
                <button onclick="startJourneyFromUI()" class="flex-1 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 font-bold text-xs py-2 px-3 rounded-xl shadow-lg shadow-orange-500/20 flex items-center justify-center gap-1.5 transition transform active:scale-95">
                    <i class="fa-solid fa-play"></i>
                    <span>Khởi hành Tham quan</span>
                </button>
                <button onclick="toggleChaseCamera()" id="btn-chase-cam" class="px-2.5 py-2 rounded-xl border border-slate-600 bg-slate-800/80 text-slate-300 text-xs font-medium hover:border-cyan-400 transition" title="Bật/Tắt Camera đi theo phương tiện 3D">
                    <i class="fa-solid fa-video mr-1"></i>Cam hành trình
                </button>
            </div>

            <!-- Active Telemetry Status Bar (Shown during travel) -->
            <div id="journey-telemetry" class="hidden bg-slate-950/90 border border-amber-500/40 rounded-xl p-2.5 text-xs">
                <div class="flex items-center justify-between text-amber-300 font-bold mb-1">
                    <span id="telemetry-route">Hà Nội ➔ Quảng Ninh</span>
                    <span id="telemetry-dist">155 km</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mb-1">
                    <div id="telemetry-progress" class="bg-gradient-to-r from-cyan-400 to-amber-400 h-full w-0 transition-all duration-75"></div>
                </div>
                <div id="telemetry-status" class="text-[11px] text-slate-300 italic">Đang di chuyển trên cao tốc...</div>
            </div>
        </div>

        <!-- 2. DIRECTORY OF 34 PROVINCES & REGIONS -->
        <div class="glass-panel rounded-2xl p-3.5 flex-1 flex flex-col min-h-0">
            <div class="flex items-center justify-between mb-2">
                <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-300 flex items-center gap-1.5">
                    <i class="fa-solid fa-map-location-dot"></i>
                    <span>Danh mục 34 Tỉnh / Thành</span>
                </h2>
                <span class="text-[11px] text-slate-400" id="filtered-count">34 đơn vị</span>
            </div>

            <!-- Search & Region Filter -->
            <div class="flex flex-col gap-1.5 mb-2.5">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2 text-slate-400 text-xs"></i>
                    <input id="search-province" type="text" oninput="filterProvinceList()" placeholder="Tìm tỉnh mới, tỉnh cũ (VD: Hà Giang, Cát Bà)..." class="w-full bg-slate-900/90 border border-slate-700 rounded-xl pl-8 pr-3 py-1.5 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-cyan-400">
                </div>
                <select id="filter-region" onchange="filterProvinceList()" class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-cyan-400">
                    <option value="ALL">🌏 Tất cả 6 Vùng Du lịch (34 Tỉnh/Thành)</option>
                    <option value="V1">⛰️ Vùng 1: Trung du & Miền núi phía Bắc (10)</option>
                    <option value="V2">🏯 Vùng 2: Đồng bằng sông Hồng (5)</option>
                    <option value="V3">🏖️ Vùng 3: Bắc Trung Bộ & Duyên hải Miền Trung (8)</option>
                    <option value="V4">🌲 Vùng 4: Tây Nguyên - Nam Trung Bộ mở rộng (3)</option>
                    <option value="V5">🏙️ Vùng 5: Đông Nam Bộ (3)</option>
                    <option value="V6">🛶 Vùng 6: Đồng bằng sông Cửu Long (5)</option>
                </select>
            </div>

            <!-- Scrollable List of 34 Provinces -->
            <div id="province-list-container" class="flex-1 overflow-y-auto space-y-1.5 pr-1"></div>

            <!-- Reference Map Color Legend -->
            <div class="pt-2 mt-2 border-t border-slate-700/70 flex items-center justify-between text-[10px] text-slate-300">
                <span>Bảng màu Bản đồ mẫu:</span>
                <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#F5C71A] inline-block" title="Vàng"></span>
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#F05A22] inline-block" title="Cam đỏ"></span>
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#2CE5C3] inline-block" title="Xanh ngọc"></span>
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#10B981] inline-block" title="Xanh lá"></span>
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#0047BA] inline-block" title="Xanh dương đậm"></span>
                </div>
            </div>
        </div>
    </aside>

    <!-- RIGHT SIDEBAR: DOSSIER & TOUR GUIDE PANEL -->
    <aside id="right-sidebar" class="fixed top-20 right-3 bottom-20 w-88 md:w-96 z-20 flex flex-col glass-panel rounded-2xl overflow-hidden shadow-2xl border border-cyan-400/40">
        <!-- Dossier Header -->
        <div class="p-3.5 bg-gradient-to-r from-cyan-950 via-slate-900 to-indigo-950 border-b border-slate-700/80">
            <div class="flex items-center justify-between mb-1">
                <span id="dossier-code-badge" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded text-slate-950" style="background:#2CE5C3">ĐƠN VỊ 09/34</span>
                <span id="dossier-region-badge" class="text-[10px] text-cyan-300 font-semibold">Đông Bắc & Duyên hải Bắc Bộ</span>
            </div>
            <div class="flex items-center justify-between">
                <h2 id="dossier-title" class="text-base font-black text-white tracking-wide flex items-center gap-2">
                    <span>QUẢNG NINH</span>
                </h2>
                <button onclick="travelToSelectedProvince()" class="px-2.5 py-1 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs shadow flex items-center gap-1 transition">
                    <i class="fa-solid fa-plane-departure"></i>
                    <span>Bay tới đây</span>
                </button>
            </div>
            <div id="dossier-merged" class="text-[11px] text-amber-300 mt-1 font-medium">Giữ nguyên (Tỉnh Quảng Ninh)</div>
        </div>

        <!-- Hubs Bar -->
        <div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800 flex flex-wrap items-center gap-1.5" id="dossier-hubs-list"></div>

        <!-- Dossier Navigation Tabs -->
        <div class="grid grid-cols-4 text-xs font-semibold bg-slate-950/80 border-b border-slate-800">
            <button onclick="switchDossierTab('attractions')" id="dtab-attractions" class="py-2.5 text-center border-b-2 border-cyan-400 text-cyan-300 transition">Điểm đến</button>
            <button onclick="switchDossierTab('overview')" id="dtab-overview" class="py-2.5 text-center border-b-2 border-transparent text-slate-400 hover:text-white transition">Tổng quan</button>
            <button onclick="switchDossierTab('cuisine')" id="dtab-cuisine" class="py-2.5 text-center border-b-2 border-transparent text-slate-400 hover:text-white transition">Ẩm thực</button>
            <button onclick="switchDossierTab('quiz')" id="dtab-quiz" class="py-2.5 text-center border-b-2 border-transparent text-slate-400 hover:text-white transition">Nhận dấu</button>
        </div>

        <!-- Dossier Content Body -->
        <div id="dossier-content" class="flex-1 overflow-y-auto p-3.5 space-y-3"></div>

        <!-- Dossier Footer: Audio Guide (Thuyết minh tự động Giọng Nữ Miền Bắc) -->
        <div class="p-3 bg-slate-950/95 border-t border-slate-800 flex flex-col gap-2">
            <!-- Voice Settings Bar -->
            <div class="flex items-center justify-between gap-1.5 text-[11px] bg-slate-900/90 px-2.5 py-1.5 rounded-xl border border-slate-700/80">
                <div class="flex items-center gap-1.5 min-w-0 flex-1">
                    <i class="fa-solid fa-headset text-pink-400 shrink-0"></i>
                    <select id="voice-engine-select" onchange="changeVoiceEngine(this.value)" class="bg-transparent text-pink-200 font-semibold focus:outline-none truncate w-full cursor-pointer" title="Chọn Giọng Nữ Hướng dẫn viên Miền Bắc">
                        <option value="auto_northern" class="bg-slate-900 text-white">🎙️ Nữ HDV Miền Bắc (Hoài My / Chuẩn Hà Nội)</option>
                        <option value="cloud_northern" class="bg-slate-900 text-white">☁️ Nữ HDV Miền Bắc (Cloud Tiêu Chuẩn)</option>
                        <option value="browser_female" class="bg-slate-900 text-white">🔊 Nữ HDV Hệ thống (Web Speech Nữ)</option>
                    </select>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                    <select id="voice-speed-select" onchange="changeVoiceSpeed(this.value)" class="bg-slate-800 text-cyan-300 font-bold px-1.5 py-0.5 rounded border border-slate-600 focus:outline-none text-[10px]" title="Tốc độ đọc thuyết minh">
                        <option value="0.92">0.9x (Rõ từng chữ)</option>
                        <option value="0.98" selected>1.0x (Chuẩn HDV)</option>
